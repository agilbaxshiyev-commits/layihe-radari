# Bu faylı ".env" adı ilə kopyala və dəyərləri özün yaz. ".env" git-ə düşmür.

# AI: istənilən OpenAI-uyğun API. Standart olaraq Google Gemini istifadə olunur.
AI_API_KEY=
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Boş qalsa ən yeni "flash" model avtomatik seçilir. Siyahı: python -m radar models
# AI_MODEL=

# Telegram: @BotFather-dən alınan token və öz chat ID-n.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Panelin ünvanı (Telegram-dakı "Paneldə aç" düyməsi üçün).
# PANEL_URL=https://<istifadeci>.github.io/<repo>
